# Copy to .env and fill in real values. .env is git-ignored — never commit it.
# See docs/TIMEOS_ENGINEERING_SPEC.md §28 (Security: Secrets).

# --- PostgreSQL ---
POSTGRES_USER=timeos
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=timeos

# --- Backend ---
TIMEOS_ENVIRONMENT=development

# --- AI provider (Phase 7/8). Leave as "null" until Phase 7 lands — the system must run with
# zero AI configuration (§22.10). ---
TIMEOS_AI_PROVIDER=null
TIMEOS_AI_API_KEY=

# --- Deployment (production only, used by Caddy) ---
TIMEOS_DOMAIN=timeos.example.com
