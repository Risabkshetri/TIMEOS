# Copy to .env and fill in real values. .env is git-ignored — never commit it.
# See docs/TIMEOS_ENGINEERING_SPEC.md §28 (Security: Secrets).

# --- PostgreSQL ---
POSTGRES_USER=timeos
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=timeos

# --- Backend ---
TIMEOS_ENVIRONMENT=development
# Signs dashboard session cookies (§25, §28). Generate with: openssl rand -hex 32
TIMEOS_SESSION_SECRET=change-me-to-a-long-random-value

# --- AI provider (Phase 7/8). Leave as "null" — the system must run with zero AI configuration
# (§22.10). One of: null | anthropic | openai | groq | google | ollama. Groq (console.groq.com)
# and Google AI Studio (aistudio.google.com) both issue a free API key with no payment method
# required, which makes them the practical choice for testing a real provider call end-to-end;
# Anthropic/OpenAI are paid-only and Ollama needs a local model install. TIMEOS_AI_MODEL is
# optional — each provider has a small, cheap default (see timeos/ai/provider.py's DEFAULT_MODELS)
# — set it if you want a different model from that provider's catalogue. ---
TIMEOS_AI_PROVIDER=null
TIMEOS_AI_API_KEY=
TIMEOS_AI_MODEL=
TIMEOS_AI_MONTHLY_BUDGET_USD=5.0

# --- Deployment (production only, used by Caddy) ---
TIMEOS_DOMAIN=timeos.example.com
