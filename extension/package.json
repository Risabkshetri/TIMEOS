{
  "name": "timeos-extension",
  "displayName": "TimeOS",
  "version": "0.1.0",
  "description": "TimeOS domain-level web attribution — no page content, ever.",
  "author": "TimeOS",
  "scripts": {
    "dev": "plasmo dev",
    "dev:firefox": "plasmo dev --target=firefox-mv3",
    "build": "plasmo build",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "build:all": "npm run build && npm run build:firefox",
    "package": "plasmo package",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tldts": "^6.1.62",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@types/webextension-polyfill": "^0.10.7",
    "prettier": "3.2.4",
    "typescript": "5.3.3",
    "vitest": "^2.1.9"
  },
  "manifest": {
    "permissions": [
      "tabs",
      "idle",
      "storage",
      "alarms"
    ]
  }
}
